[Unit]
Description=m321 backend (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/m321-backend
EnvironmentFile=-/home/admin/m321-backend/.env
ExecStart=/home/admin/m321-backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
