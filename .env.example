# Sensor devices to poll (comma-separated IPs or hostnames).
# Multiple hosts are treated as redundant replicas of the same sensor:
# all hosts are polled in parallel and their readings are averaged,
# so unreachable hosts are skipped while the remaining ones still
# produce a valid reading.
SENSOR_HOSTS=10.125.218.57,10.125.218.42

# TCP port the sensor devices listen on
SENSOR_PORT=8080

# Polling interval in seconds
POLL_INTERVAL=3600

# Other backend instances to sync with (comma-separated URLs, e.g. http://192.168.1.10:8000)
PEER_URLS=
